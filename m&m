## 3. Step 3 – Dataflow / Apache Beam pipeline (Python)

Now the fun part: **joining these 5 tables using Beam**.

High level:

1. Read from BigQuery: 5 PCollections
2. Convert each into key/value pairs:

   * accounts keyed by `ACCOUNT_NUMBER`
   * fulfilled accounts keyed by `fulfilledAccountId`
   * facilities keyed by `facilityInstanceId`
   * mapped_facility keyed by `facilityInstanceId`
   * facility_purpose keyed by `facilityInstanceId`
3. Join accounts ↔ fulfilled accounts using `CoGroupByKey`
4. For each matched account/facilityInstanceId, join to facility + mapping + purpose.
5. Write final rows to a BigQuery table `vnp_account_facility_single_view`.

### 3.1 Install Apache Beam locally (for dev)

```bash
pip install apache-beam[gcp]
```

### 3.2 Beam pipeline code (simplified but working)

Create file: `vnp_merge_match_pipeline.py`

```python
import apache_beam as beam
from apache_beam.options.pipeline_options import PipelineOptions, GoogleCloudOptions, StandardOptions

PROJECT = "PROJECT_ID"
DATASET = "merge_match_dev"
REGION = "europe-west2"  # or your region
TEMP_LOCATION = "gs://YOUR_BUCKET/temp"
JOB_NAME = "vnp-merge-match"

class MakeKV(beam.DoFn):
    def __init__(self, key_field):
        self.key_field = key_field

    def process(self, element):
        key = element[self.key_field]
        yield (key, element)

def run(argv=None):
    options = PipelineOptions(argv)
    gcloud_options = options.view_as(GoogleCloudOptions)
    gcloud_options.project = PROJECT
    gcloud_options.region = REGION
    gcloud_options.job_name = JOB_NAME
    gcloud_options.temp_location = TEMP_LOCATION

    options.view_as(StandardOptions).runner = 'DataflowRunner'   # or 'DirectRunner' for local tests

    with beam.Pipeline(options=options) as p:

        # 1. Read from BigQuery
        accounts = (
            p
            | "ReadAccounts" >> beam.io.ReadFromBigQuery(
                table=f"{PROJECT}:{DATASET}.vnp_accounts_mock")
            | "AccountKV" >> beam.ParDo(MakeKV("ACCOUNT_NUMBER"))
        )

        fulfilled = (
            p
            | "ReadFulfilled" >> beam.io.ReadFromBigQuery(
                table=f"{PROJECT}:{DATASET}.fulfilled_account_mock")
            | "FulfilledKV" >> beam.ParDo(MakeKV("fulfilledAccountId"))
        )

        facilities = (
            p
            | "ReadFacilities" >> beam.io.ReadFromBigQuery(
                table=f"{PROJECT}:{DATASET}.credit_facility_mock")
            | "FacilityKV" >> beam.ParDo(MakeKV("facilityInstanceId"))
        )

        mapped = (
            p
            | "ReadMapped" >> beam.io.ReadFromBigQuery(
                table=f"{PROJECT}:{DATASET}.mapped_facility_mock")
            | "MappedKV" >> beam.ParDo(MakeKV("facilityInstanceId"))
        )

        purposes = (
            p
            | "ReadPurpose" >> beam.io.ReadFromBigQuery(
                table=f"{PROJECT}:{DATASET}.facility_purpose_mock")
            | "PurposeKV" >> beam.ParDo(MakeKV("facilityInstanceId"))
        )

        # 2. Join accounts ↔ fulfilled accounts on account number
        accounts_and_fulfilled = (
            {"acct": accounts, "fa": fulfilled}
            | "JoinAccountFulfilled" >> beam.CoGroupByKey()
        )

        # 3. Convert that into keyed by facilityInstanceId
        #    (one account can connect to 0/1 facilityInstanceIds via fulfilled)
        def expand_account_facility(kv):
            acct_number, groups = kv
            acct_rows = groups["acct"]
            fa_rows = groups["fa"]
            for acct in acct_rows:
                if fa_rows:
                    for fa in fa_rows:
                        yield (fa["facilityInstanceId"], {"account": acct, "fa": fa})
                else:
                    # account with no fulfilled facility → you can ignore or output unmatched
                    pass

        acct_by_facility = accounts_and_fulfilled | "AccountByFacility" >> beam.FlatMap(expand_account_facility)

        # 4. Join facilityInstanceId with facilities, mapped, purposes
        joined_facility_side = (
            {"acct": acct_by_facility,
             "facility": facilities,
             "mapped": mapped,
             "purpose": purposes}
            | "JoinFacilityAll" >> beam.CoGroupByKey()
        )

        # 5. Build final single-view records
        def build_single_view(kv):
            facility_instance_id, groups = kv

            acct_entries = groups["acct"]
            facility_rows = groups["facility"]
            mapped_rows = groups["mapped"]
            purpose_rows = groups["purpose"]

            if not acct_entries or not facility_rows:
                return  # skip incomplete records in this simple POC

            acct = acct_entries[0]["account"]
            fa = acct_entries[0]["fa"]
            facility = facility_rows[0]
            mapped = mapped_rows[0] if mapped_rows else {}
            # can be multiple purposes; join with '; '
            purposes = "; ".join([p["purpose"] for p in purpose_rows]) if purpose_rows else None

            yield {
                "ACCOUNT_NUMBER": acct["ACCOUNT_NUMBER"],
                "ACCOUNT_CODE": acct["ACCOUNT_CODE"],
                "ACCOUNT_NAME": acct["ACCOUNT_NAME"],
                "ACCOUNT_BALANCE": acct["ACCOUNT_BALANCE"],
                "ACCOUNT_LIMIT": acct["LIMIT"],
                "CURRENCY_CODE": acct["CURRENCY_CODE"],
                "SOURCE_SYSTEM_ID": acct["SOURCE_SYSTEM_ID"],
                "EXTERNAL_SYSTEM_NAME": acct["EXTERNAL_SYSTEM_NAME"],
                "LOAD_DATE": acct["LOAD_DATE"].isoformat() if hasattr(acct["LOAD_DATE"], "isoformat") else str(acct["LOAD_DATE"]),

                "facilityId": facility["facilityId"],
                "facilityInstanceId": facility["facilityInstanceId"],
                "customerId": facility["customerId"],
                "proposalId": facility["proposalId"],
                "typeOfCommitment": facility["typeOfCommitment"],
                "productGroupId": facility["productGroupId"],
                "productName": facility["productName"],
                "productId": facility["productId"],
                "facilityStage": facility["facilityStage"],
                "requestedFacilityLimit": facility["requestedFacilityLimit"],
                "existingSanctionedLimit": facility["existingSanctionedLimit"],
                "facilityCreatedDate": facility["createdDate"],
                "facilityUpdatedDate": facility["updatedDate"],

                "sourceSystemName": mapped.get("sourceSystemName"),
                "sourceFacilityId": mapped.get("facilityId"),
                "purposes": purposes,

                "fulfilledAccountId": fa["fulfilledAccountId"]
            }

        single_view = joined_facility_side | "BuildSingleView" >> beam.FlatMap(build_single_view)

        # 6. Write to BigQuery
        single_view | "WriteSingleView" >> beam.io.WriteToBigQuery(
            table=f"{PROJECT}:{DATASET}.vnp_account_facility_single_view",
            schema={
                "fields": [
                    {"name": "ACCOUNT_NUMBER", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "ACCOUNT_CODE", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "ACCOUNT_NAME", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "ACCOUNT_BALANCE", "type": "NUMERIC", "mode": "NULLABLE"},
                    {"name": "ACCOUNT_LIMIT", "type": "NUMERIC", "mode": "NULLABLE"},
                    {"name": "CURRENCY_CODE", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "SOURCE_SYSTEM_ID", "type": "INTEGER", "mode": "NULLABLE"},
                    {"name": "EXTERNAL_SYSTEM_NAME", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "LOAD_DATE", "type": "DATE", "mode": "NULLABLE"},

                    {"name": "facilityId", "type": "INTEGER", "mode": "NULLABLE"},
                    {"name": "facilityInstanceId", "type": "INTEGER", "mode": "NULLABLE"},
                    {"name": "customerId", "type": "INTEGER", "mode": "NULLABLE"},
                    {"name": "proposalId", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "typeOfCommitment", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "productGroupId", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "productName", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "productId", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "facilityStage", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "requestedFacilityLimit", "type": "NUMERIC", "mode": "NULLABLE"},
                    {"name": "existingSanctionedLimit", "type": "NUMERIC", "mode": "NULLABLE"},
                    {"name": "facilityCreatedDate", "type": "DATETIME", "mode": "NULLABLE"},
                    {"name": "facilityUpdatedDate", "type": "DATETIME", "mode": "NULLABLE"},

                    {"name": "sourceSystemName", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "sourceFacilityId", "type": "STRING", "mode": "NULLABLE"},
                    {"name": "purposes", "type": "STRING", "mode": "NULLABLE"},

                    {"name": "fulfilledAccountId", "type": "STRING", "mode": "NULLABLE"}
                ]
            },
            write_disposition=beam.io.BigQueryDisposition.WRITE_TRUNCATE,
            create_disposition=beam.io.BigQueryDisposition.CREATE_IF_NEEDED
        )

if __name__ == "__main__":
    run()
```

